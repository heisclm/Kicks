# ==========================================
# KICKS MOBILE APP - ENVIRONMENT VARIABLES
# ==========================================
# 1. Duplicate this file and rename it to .env
# 2. Fill in the values from your Supabase Project Settings -> API.
# 3. Do NOT commit the .env file to version control.

# [REQUIRED] Your Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Your Supabase Anon/Public Key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# [OPTIONAL] Set to "true" ONLY if you want to bypass actual authentication and API calls during UI design.
# Must be set to "false" (or removed) for production!
EXPO_PUBLIC_USE_MOCK_DATA=false

# Google Maps API Key for Address Autocomplete
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
